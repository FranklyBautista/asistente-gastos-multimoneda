# Supabase local (`.\tasks.ps1 db-up`; las llaves salen de `supabase status`).
# En producción: Project Settings → API del proyecto en la nube.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Opcional: usuario del bot sin @ (p. ej. frankly_gastos_bot). Muestra el botón «+» que abre
# el chat en Telegram para anotar; sin la variable, el botón no aparece.
NEXT_PUBLIC_TELEGRAM_BOT=
