# Llave publicable de Supabase (nunca la secreta ni la service role): las lecturas pasan
# por la RLS de la sesión. Copia este archivo a .env.local; los valores salen del panel de
# Supabase (Project Settings → API) o de `supabase status` en local.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
