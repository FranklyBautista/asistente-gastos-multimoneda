# Copia este archivo a .env y rellena los valores. Nunca subas .env al repositorio.
ENV=dev
TELEGRAM_BOT_TOKEN=
# Lista blanca en formato JSON, por ejemplo: [123456789]
ALLOWED_TELEGRAM_IDS=[]
# Supabase local: postgresql://postgres:postgres@127.0.0.1:55322/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Modelos de Gemini en orden de preferencia (JSON); si uno está saturado se usa el siguiente
GEMINI_MODELS=["gemini-3.5-flash","gemini-3.5-flash-lite","gemini-3.8-flash"]
LLM_TIMEOUT_SECONDS=20
GROQ_API_KEY=
RATES_API_KEY=
# Tasas: cada cuántos minutos se refrescan y tras cuántas horas sin actualizarse se marcan como viejas
RATES_REFRESH_MINUTES=60
RATES_MAX_AGE_HOURS=6
# Resumen semanal: el domingo desde esta hora local (0-23), según la zona horaria de cada usuario
WEEKLY_SUMMARY_HOUR=18
# Mensajes por minuto y por persona antes de pedir que espere (protege la cuota del LLM)
RATE_LIMIT_PER_MINUTE=20
# Solo en producción (ver docs/DESPLIEGUE.md). Vacío = modo polling.
# WEBHOOK_URL es la URL pública base, sin ruta: https://<servicio>.up.railway.app
WEBHOOK_URL=
# 16–256 caracteres A-Z a-z 0-9 _ -: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
# Puerto del servidor del webhook; Railway lo inyecta
PORT=8080
